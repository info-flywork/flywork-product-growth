# Bu dosyayı ".env" olarak kopyalayıp kendi anahtarlarını gir.
# cp .env.example .env

# OpenAI API anahtarı — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Tavily Search API anahtarı (canlı web verisi için) — https://tavily.com
# Ücretsiz katman ayda 1000 arama veriyor, kayıt olunca anahtar hemen hazır.
TAVILY_API_KEY=tvly-...

# Figma kişisel erişim anahtarı — dosyadaki ekranları okumak için.
# Figma → Settings → Security → Personal access tokens
FIGMA_ACCESS_TOKEN=figd-...

# Kullanılacak OpenAI modeli (opsiyonel, varsayılan: gpt-4o)
# Daha ucuz/hızlı için: gpt-4o-mini
OPENAI_MODEL=gpt-4o
